#!/bin/sh

set -eu

MAVEN_VERSION="${MAVEN_VERSION:-3.9.11}"
MAVEN_HOME="${MAVEN_HOME:-$HOME/.m2/wrapper/dists/apache-maven-$MAVEN_VERSION}"
MAVEN_BIN="$MAVEN_HOME/bin/mvn"

if [ ! -x "$MAVEN_BIN" ]; then
  archive="$HOME/.m2/wrapper/dists/apache-maven-$MAVEN_VERSION-bin.tar.gz"
  mkdir -p "$MAVEN_HOME"
  if [ ! -f "$archive" ]; then
    curl -fL "https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MAVEN_VERSION/apache-maven-$MAVEN_VERSION-bin.tar.gz" -o "$archive"
  fi
  temp_dir="$(mktemp -d)"
  trap 'rm -rf "$temp_dir"' EXIT
  tar -xzf "$archive" -C "$temp_dir"
  rm -rf "$MAVEN_HOME"
  mv "$temp_dir/apache-maven-$MAVEN_VERSION" "$MAVEN_HOME"
fi

exec "$MAVEN_BIN" "$@"
